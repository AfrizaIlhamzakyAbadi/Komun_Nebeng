<com.android.internal.widget.ResolverDrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_lock_promo_activity_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:maxWidth="@dimen/app_lock_dialog_max_width"
    android:maxCollapsedHeight="@dimen/app_lock_edu_dialog_max_collapsed_height"
    android:paddingTop="@dimen/app_lock_top_margin">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bottomsheet_expressive_background"
        android:paddingTop="@dimen/dialog_padding_material">

        <ScrollView
            android:id="@+id/app_lock_promo_dialog_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="?android:attr/dialogPreferredPadding"
                android:paddingEnd="?android:attr/dialogPreferredPadding">

                <ImageView
                    android:layout_width="@dimen/resolver_icon_size"
                    android:layout_height="@dimen/resolver_icon_size"
                    android:src="@drawable/ic_suggestion_lightbulb_sparkle"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@null"
                    android:tint="@color/materialColorPrimary"
                    android:layout_marginBottom="@dimen/app_lock_margin_medium"/>

                <TextView
                    android:id="@+id/app_lock_promo_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_lock_settings_promo_dialog_title"
                    android:textAppearance="@style/TextAppearance.DeviceDefault.AppLock.Title"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/app_lock_margin_medium" />

                <TextView
                    android:id="@+id/app_lock_promo_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_lock_settings_promo_dialog_description"
                    android:textAppearance="@style/TextAppearance.DeviceDefault.AppLock.Body"
                    android:textAlignment="viewStart"
                    android:layout_marginBottom="@dimen/app_lock_margin_medium" />
            </LinearLayout>
        </ScrollView>

        <View
            android:id="@+id/app_lock_promo_dialog_bottom_sheet_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/app_lock_item_margin_small"
            android:background="?android:attr/listDivider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="?android:attr/dialogPreferredPadding"
            android:paddingEnd="?android:attr/dialogPreferredPadding"
            android:paddingTop="@dimen/app_lock_padding_extra_small"
            android:paddingBottom="@dimen/app_lock_padding_large">

            <Button
                android:id="@+id/app_lock_settings_promo_dialog_positive_button"
                style="@android:style/Widget.DeviceDefault.Button.Colored"
                android:background="@drawable/app_lock_btn_pill_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/app_lock_button_padding"
                android:paddingBottom="@dimen/app_lock_button_padding"
                android:minHeight="@dimen/app_lock_edu_button_min_height"
                android:layout_marginBottom="@dimen/app_lock_item_margin_small"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="@string/global_action_settings"
                android:textColor="@color/materialColorOnPrimary"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/app_lock_settings_promo_dialog_negative_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/app_lock_button_padding"
                android:paddingBottom="@dimen/app_lock_button_padding"
                android:minHeight="@dimen/app_lock_edu_button_min_height"
                android:layout_marginTop="@dimen/app_lock_item_margin_small"
                android:text="@string/close_button_text"
                android:textColor="@color/materialColorPrimary"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</com.android.internal.widget.ResolverDrawerLayout>
