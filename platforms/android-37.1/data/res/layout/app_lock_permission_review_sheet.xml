<com.android.internal.widget.ResolverDrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_lock_activity_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:maxWidth="@dimen/app_lock_dialog_max_width"
    android:maxCollapsedHeight="@dimen/app_lock_edu_dialog_max_collapsed_height"
    android:paddingTop="@dimen/app_lock_top_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/dialog_padding_material"
        android:layout_ignoreOffset="true"
        android:background="@drawable/bottomsheet_expressive_background">

        <ScrollView
            android:id="@+id/app_lock_permission_review_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:fadeScrollbars="true"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/resolver_icon_size"
                    android:layout_height="@dimen/resolver_icon_size"
                    android:src="@drawable/ic_lock_bold"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@null"
                    android:tint="@color/materialColorPrimary"
                    android:layout_marginBottom="@dimen/app_lock_margin_medium"/>

                <TextView
                    android:id="@+id/app_lock_permission_review_dialog_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorPrimary"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.DeviceDefault.AppLock.Title"
                    android:paddingStart="?android:attr/dialogPreferredPadding"
                    android:paddingEnd="?android:attr/dialogPreferredPadding"
                    android:layout_marginBottom="@dimen/app_lock_item_margin"
                    android:lineHeight="@dimen/app_lock_line_height_large"/>

                <TextView
                    android:id="@+id/app_lock_permission_review_dialog_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_lock_item_margin"
                    android:layout_marginBottom="@dimen/app_lock_item_margin"
                    android:paddingStart="?android:attr/dialogPreferredPadding"
                    android:paddingEnd="?android:attr/dialogPreferredPadding"
                    android:textAppearance="@style/TextAppearance.DeviceDefault.AppLock.Subtitle"/>

                <com.android.internal.app.AppLockMaxHeightRecyclerView
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/app_lock_permission_review_app_list_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:paddingStart="?android:attr/dialogPreferredPadding"
                    android:paddingEnd="?android:attr/dialogPreferredPadding"
                    android:scrollbars="vertical"
                    android:scrollbarStyle="outsideOverlay"
                    android:nestedScrollingEnabled="false"
                    android:scrollbarThumbVertical="@drawable/app_lock_scrollbar_handle"
                    app:layoutManager="com.android.internal.widget.LinearLayoutManager" />

                <LinearLayout
                    android:id="@+id/app_lock_permission_review_btn_view_all"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="@dimen/app_lock_item_margin"
                    android:paddingBottom="@dimen/app_lock_item_margin"
                    android:layout_marginBottom="@dimen/app_lock_margin_bottom"
                    android:minHeight="@dimen/app_lock_edu_button_min_height"
                    android:paddingStart="?android:attr/dialogPreferredPadding"
                    android:paddingEnd="?android:attr/dialogPreferredPadding"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/app_lock_item_icon_size"
                        android:layout_height="@dimen/app_lock_item_icon_size"
                        android:padding="@dimen/app_lock_padding_extra_small"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_chevron_end_round"
                        android:tint="@color/materialColorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/app_lock_item_margin"
                        android:text="@string/app_lock_permission_review_expand_app_list_button"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textAppearance="@style/TextAppearance.DeviceDefault.AppLock.ItemText"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <View
            android:id="@+id/app_lock_permission_review_bottom_sheet_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:visibility="gone" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_lock_item_margin"
            android:layout_marginBottom="@dimen/navigation_bar_height"
            android:paddingTop="@dimen/app_lock_padding_extra_small"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="?android:attr/dialogPreferredPadding"
            android:paddingEnd="?android:attr/dialogPreferredPadding"
            android:paddingBottom="@dimen/app_lock_padding_large">

            <Button
                android:id="@+id/app_lock_permission_review_btn_cancel"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/app_lock_edu_button_min_height"
                android:layout_gravity="center_vertical"
                android:textAppearance="?android:attr/textAppearanceButton"
                android:paddingStart="@dimen/app_lock_padding_medium"
                android:paddingEnd="@dimen/app_lock_padding_medium"
                android:textAllCaps="false"
                android:textColor="@color/materialColorPrimary"
                android:text="@string/cancel" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/app_lock_permission_review_btn_continue"
                style="@android:style/Widget.DeviceDefault.Button.Colored"
                android:background="@drawable/app_lock_btn_pill_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/app_lock_edu_button_min_height"
                android:layout_gravity="center_vertical"
                android:minWidth="0dp"
                android:textAllCaps="false"
                android:paddingStart="@dimen/app_lock_padding_medium"
                android:paddingEnd="@dimen/app_lock_padding_medium"
                android:textColor="@color/materialColorOnPrimary"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="@string/app_lock_permission_review_continue_button" />
        </LinearLayout>
    </LinearLayout>
</com.android.internal.widget.ResolverDrawerLayout>
